# ==============================================================
# .env.example — PolitiCRM
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real a Git.
#
# cp .env.example .env
# ==============================================================


# ==============================================================
# BASE DE DATOS — PostgreSQL
# ==============================================================
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Crm_estrategico

# Configuración avanzada del pool (opcional, los defaults funcionan bien)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Mostrar cada SQL generado en consola (true solo para desarrollo)
DB_ECHO_SQL=false


# ==============================================================
# FACEBOOK / META
# ==============================================================

# Token de acceso de la página de Facebook
# Obtener en: Meta for Developers → Tu App → Messenger → Tokens de acceso
FACEBOOK_PAGE_ACCESS_TOKEN=tu_page_access_token_aqui

# Token de verificación del webhook (lo defines tú, debe coincidir en Meta Developers)
FACEBOOK_VERIFY_TOKEN=mi_token_de_prueba

# Versión de la Graph API de Meta (recomendado mantener actualizado)
FACEBOOK_API_VERSION=v20.0


# ==============================================================
# WHATSAPP — Meta Cloud API
# ==============================================================

# ID del número de teléfono registrado en Meta Business
# Obtener en: Meta for Developers → Tu App → WhatsApp → Configuración
WA_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Token de acceso de sistema (permanente) para WhatsApp
WA_ACCESS_TOKEN=tu_whatsapp_access_token_aqui

# Versión de la API de WhatsApp
WA_API_VERSION=v19.0

# Pausa entre mensajes masivos (segundos) — respetar rate limit de Meta
WA_DELAY=1.2


# ==============================================================
# CAMPAÑA
# ==============================================================

# Nombre del candidato (se usa en mensajes del bot y nurturing)
CANDIDATO_NOMBRE=Carlos Julio Socha


# ==============================================================
# EMAIL (opcional — para integrar SMTP real)
# ==============================================================

# Servidor SMTP (ej: smtp.gmail.com, smtp.sendgrid.net)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASSWORD=tu_app_password_aqui
# SMTP_FROM=tucorreo@gmail.com
